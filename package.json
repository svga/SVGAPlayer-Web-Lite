{
  "name": "svga",
  "version": "2.2.0",
  "description": "Lightweight SVGA Web Player",
  "keywords": [
    "svga"
  ],
  "homepage": "https://github.com/svga/SVGAPlayer-Web-Lite/#readme",
  "bugs": {
    "url": "https://github.com/svga/SVGAPlayer-Web-Lite/issues"
  },
  "license": "Apache-2.0",
  "author": "SVGA",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svga/SVGAPlayer-Web-Lite"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "jsdelivr": "dist/index.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vitest --watch",
    "clean": "node scripts/clean.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings src tests scripts playwright.config.ts vitest.config.mts",
    "type:check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "coverage": "vitest run --coverage",
    "test:browser": "npm run build && playwright test",
    "test:browser:chromium": "npm run build && playwright test --project=chromium",
    "test:package": "node scripts/verify-package.mjs",
    "build": "node scripts/build.mjs",
    "size": "node scripts/check-size.mjs",
    "visual": "npm run build && node scripts/serve-visual-test.mjs",
    "verify:fast": "npm run lint && npm run format:check && npm run type:check && npm run coverage",
    "verify": "npm run verify:fast && npm run test:browser && npm run test:package && npm run size",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "acorn": "^8.19.0",
    "fake-indexeddb": "^6.2.6",
    "fflate": "^0.8.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "protobufjs": "^8.8.1",
    "publint": "^0.3.25",
    "rollup": "^4.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite4": "npm:vite@^4.4.5",
    "vitest": "^5.0.5",
    "webpack": "^5.112.0",
    "webpack-cli": "^6.0.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^12.2.1",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^24.22.1 || >=26.0.0",
      "onFail": "error"
    }
  },
  "packageManager": "npm@12.2.1"
}
