{
  "name": "svga",
  "version": "2.2.0",
  "description": "Lightweight SVGA Web Player",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "jsdelivr": "dist/index.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "keywords": [
    "svga"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svga/SVGAPlayer-Web-Lite"
  },
  "bugs": {
    "url": "https://github.com/svga/SVGAPlayer-Web-Lite/issues"
  },
  "homepage": "https://github.com/svga/SVGAPlayer-Web-Lite/#readme",
  "scripts": {
    "dev": "vitest --watch",
    "lint": "oxlint --deny-warnings --ignore-pattern src/parser/svga.generated.ts src tests scripts playwright.config.ts vitest.config.mts",
    "type:check": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:browser": "npm run build && playwright test",
    "test:package": "node scripts/verify-package.mjs",
    "build": "node scripts/build.mjs",
    "visual": "npm run build && node scripts/serve-visual-test.mjs",
    "verify": "npm run lint && npm run type:check && npm run coverage && npm run test:browser && npm run test:package",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "packageManager": "npm@12.2.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "^12.2.1",
      "onFail": "error"
    }
  },
  "author": "SVGA",
  "license": "Apache-2.0",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.11",
    "acorn": "^8.19.0",
    "fake-indexeddb": "^6.2.6",
    "fflate": "^0.8.3",
    "oxlint": "^1.89.0",
    "protobufjs": "^8.8.1",
    "rollup": "^4.65.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
