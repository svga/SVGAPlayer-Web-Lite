{
  "name": "svga",
  "version": "2.1.1",
  "packageManager": "bun@1.1.0",
  "description": "Lightweight SVGA Web Player",
  "main": "dist/index.cjs.min.js",
  "module": "dist/index.esm.min.js",
  "browser": "dist/index.min.js",
  "types": "dist/index.d.ts",
  "jsdelivr": "dist/index.min.js",
  "keywords": [
    "svga"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svga/SVGAPlayer-Web-Lite"
  },
  "bugs": {
    "url": "https://github.com/svga/SVGAPlayer-Web-Lite/issues"
  },
  "homepage": "https://github.com/svga/SVGAPlayer-Web-Lite/#readme",
  "scripts": {
    "format:check": "oxlint",
    "format:fix": "oxlint --fix",
    "type:check": "tsc --noEmit",
    "test": "bun --bun vitest run",
    "test:ui": "bun --bun vitest run --ui",
    "test:coverage": "node ./node_modules/.bin/vitest run --coverage",
    "test:dev": "cross-env NODE_ENV=test rollup -c -w",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "clean": "rimraf dist",
    "build:umd": "cross-env FORMAT=umd rollup -c",
    "build:cjs": "cross-env FORMAT=cjs rollup -c",
    "build:esm": "cross-env FORMAT=esm rollup -c",
    "build:index": "cross-env NODE_ENV=production node ./scripts/inject-parser.mjs",
    "build": "run-s clean build:umd build:cjs build:esm build:index",
    "prepack": "npm run build"
  },
  "files": [
    "dist"
  ],
  "author": "SVGA",
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.5.5",
    "@babel/preset-env": "^7.5.5",
    "@commitlint/cli": "^13.1.0",
    "@commitlint/config-conventional": "^13.1.0",
    "@playwright/test": "^1.48.0",
    "@rollup/plugin-babel": "^6.0.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^15.2.0",
    "@rollup/plugin-terser": "^0.4.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "cross-env": "^5.2.0",
    "fs-extra": "^10.0.0",
    "happy-dom": "^15.0.0",
    "oxlint": "^0.7.0",
    "glob": "^7.1.7",
    "lint-staged": "^11.1.1",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.48.0",
    "protobufjs": "git+https://github.com/lijialiang/protobuf.js.git",
    "rimraf": "^6.0.0",
    "rollup": "^4.54.0",
    "rollup-plugin-babel": "^4.3.3",
    "rollup-plugin-banner": "^0.2.1",
    "rollup-plugin-livereload": "^1.0.1",
    "rollup-plugin-serve": "^1.0.1",
    "tslib": "^2.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "@vitest/ui": "^3.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "yorkie": "^2.0.0",
    "zlibjs": "git+https://github.com/lijialiang/zlib.js.git#esm"
  },
  "lint-staged": {
    "./src/**/*.{js,ts}": [
      "bun run format:fix"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "gitHooks": {
    "pre-commit": "bun run type:check && lint-staged",
    "commit-msg": "commitlint -e $GIT_PARAMS"
  }
}
