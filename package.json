{
  "name": "svga",
  "version": "2.1.1",
  "description": "Lightweight SVGA Web Player",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "jsdelivr": "dist/index.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "keywords": [
    "svga"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svga/SVGAPlayer-Web-Lite"
  },
  "bugs": {
    "url": "https://github.com/svga/SVGAPlayer-Web-Lite/issues"
  },
  "homepage": "https://github.com/svga/SVGAPlayer-Web-Lite/#readme",
  "scripts": {
    "dev": "vitest --watch",
    "lint": "oxlint --deny-warnings src tests scripts playwright.config.ts vitest.config.mts",
    "type:check": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:browser": "npm run build && playwright test",
    "test:package": "node scripts/verify-package.mjs",
    "build": "node scripts/build.mjs",
    "verify": "npm run lint && npm run type:check && npm run coverage && npm run test:browser && npm run test:package",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "packageManager": "npm@12.0.2",
  "author": "SVGA",
  "license": "Apache-2.0",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "acorn": "^8.18.0",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.3",
    "oxlint": "^1.79.0",
    "protobufjs": "git+https://github.com/lijialiang/protobuf.js.git#b84b9b2d55ce07a0c9f28519054ce6b15ab092ca",
    "rollup": "^4.62.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
